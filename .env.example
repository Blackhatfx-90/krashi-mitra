# ============================================================================
# Krashi Mitra — environment variables
#
# ⚠️  YEH FILE SIRF NAMOONA HAI. Asli value KABHI git me commit na karein.
#     Asli value Vercel -> Project -> Settings -> Environment Variables me
#     daalein. (.gitignore me .env pehle se hai.)
# ============================================================================

# ---- Database (zaroori) ----------------------------------------------------
MONGODB_URI=
MONGODB_DB=krashi_mitra

# ---- Online AI se photo ki dobara jaanch (marzi ki baat) --------------------
# Dono me se koi ek kaafi hai. Na ho to app sirf phone ke model se chalti hai.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
# Alag models try karne ho to (comma se alag):
# OPENROUTER_MODELS=google/gemma-4-31b-it:free,thinkingmachines/inkling:free

# ---- Google se login -------------------------------------------------------
# Google Cloud Console -> Credentials -> OAuth client (Web application)
# "Authorized redirect URIs" me BILKUL yeh daalein (aakhir me slash nahi):
#     https://<aapka-domain>/api/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Kshetriya admin portal (/admin) ---------------------------------------
# Pehli login par password ka bcrypt hash database me ban jaata hai; uske baad
# hamesha usi hash se milaya jaata hai. Password kabhi code ya DB me saaf-saaf
# nahi jaata. Password badalna ho to yahan nayi value daalein aur database ke
# `admins` collection se us admin ka document hata dein.
ADMIN_PORTAL_ID=
ADMIN_PORTAL_PASSWORD=

# ---- Mausam (app me alag se, js/script.js me) ------------------------------
# WEATHER_API_KEY js/script.js me hai (client-side, isliye env me nahi).

# ---- Mandi bhaav -----------------------------------------------------------
# DATAGOV_API_KEY js/mandi.js me hai (client-side, isliye env me nahi).
