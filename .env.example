# ============================================================================
# Krashi Mitra — environment variables
#
# YEH FILE SIRF EK NAMOONA HAI. Isme apni asli key MAT likhein —
# .gitignore me .env hai, par .env.example git me jaata hai.
#
# Asli key kahan daalni hai:
#   Vercel  -> Project -> Settings -> Environment Variables -> Add
#   Local   -> `export OPENROUTER_API_KEY=sk-or-v1-...` phir `vercel dev`
# ============================================================================

# ONLINE MODE ke liye (zaroori). Free key: https://openrouter.ai -> Keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional — kaunse free vision model try karne hain (comma se alag, kram me).
# Na dein to api/diagnose.js wali default chain chalti hai.
# OPENROUTER_MODELS=google/gemma-4-31b-it:free,thinkingmachines/inkling:free
